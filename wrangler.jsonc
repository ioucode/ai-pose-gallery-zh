{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pose-gallery-zh",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "observability": {
    "enabled": true
  },
  "previews": {},
  // codearea：Worker 只服务 /img、/thumbs 静态图片（实际部署配置见 cf-workers/pose-gallery/deploy.sh）
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
